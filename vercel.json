{
  "functions": { "api/**/*.js": { "maxDuration": 10 } },
  "headers": [
    { "source": "/pos/(.*)", "headers": [{ "key": "X-Frame-Options", "value": "DENY" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/admin/(.*)", "headers": [{ "key": "X-Frame-Options", "value": "DENY" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
